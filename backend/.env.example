# =============================================================================
# CyCentra 360 — /opt/cycentra/.env
# Written by cycentra-setup.sh on fresh install; maintained by operators.
# chmod 600 — never world-readable.
#
# VAULT-MANAGED KEYS (marked ▸VAULT):
#   Leave these EMPTY here. At process startup, core/kv_secrets.py reads them
#   from the configured secrets backend (Azure KV / HashiCorp / Infisical).
#   An empty or absent value triggers the vault fetch.
#   A non-empty value here takes precedence and vault is skipped (local override).
#
# NON-VAULT KEYS:
#   Generated per-install by setup.sh (openssl rand), set via the UI, or
#   hardcoded defaults. These are never fetched from vault.
# =============================================================================

# ── Identity ──────────────────────────────────────────────────────────────────
BASE_DOMAIN=cycentra.com
CLIENT_NAME=YourClientName
FRONTEND_URL=https://cy360.cycentra.com
BASE_URL=https://cyasm.cycentra.com

# ── Per-install Flask secrets (openssl rand -hex 32) ─────────────────────────
# NOT vault-managed — unique per deployment; no point storing centrally.
SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME

# ── OAuth provider ────────────────────────────────────────────────────────────
# google | microsoft | cycentra
OAUTH_PROVIDER=google

# ── OAuth credentials — ▸VAULT ───────────────────────────────────────────────
# Vault secret names:  SSO-CLIENT-ID, SSO-CLIENT-SECRET,
#                      GOOGLE-CLIENT-ID, GOOGLE-CLIENT-SECRET,
#                      MICROSOFT-CLIENT-ID, MICROSOFT-CLIENT-SECRET
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── OIDC client secrets — per-install (openssl rand -hex 32) ─────────────────
# These are generated once at install and registered with the portal IdP.
# NOT vault-managed — written directly into .env by setup.sh.
CYSOAR_OIDC_SECRET=CHANGE_ME
CYSIEM_OIDC_SECRET=CHANGE_ME
CY360SSO_OIDC_SECRET=CHANGE_ME

# ── oauth2-proxy — per-install ────────────────────────────────────────────────
OAUTH2PROXY_SECRET=CHANGE_ME
OAUTH2PROXY_COOKIE_SECRET=CHANGE_ME

# ── CySOAR ────────────────────────────────────────────────────────────────────
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME
CYCENTRA_PORTAL_URL=https://cy360.cycentra.com

# ── SMTP — NOT vault-managed ──────────────────────────────────────────────────
# Primary config is via System Settings → SMTP in the UI (stored in DB).
# These env vars are the fallback when no DB config exists.
# All four fields must be set together; a partial config won't send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@cycentra.com

# ── Internal services ─────────────────────────────────────────────────────────
# SIEM engine listens on 127.0.0.1:8100 (cysiemstack service)
SIEM_ENGINE_URL=http://127.0.0.1:8100

# Portal user/RBAC DB — reuses the correlation DB (port 5433)
CYCENTRA_DB_URL=postgresql://corruser:CHANGE_ME@127.0.0.1:5433/correlation

# ── Marketplace catalog — ▸VAULT ────────────────────────────────────────────
# Vault secret name: MARKETPLACE-CATALOG-TOKEN
# Pre-shared token sent as X-CyCentra-Token when the backend fetches the
# cloud catalog from cycentra.com/marketplace/.  One token covers all
# installations — store it in the vault once, rotate centrally if needed.
# The same value must be set in the cycentra.com container env.
# Generate (one-time):  python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotation: update vault + cycentra.com env → all instances pick up the new
#   token automatically at the next daily secret refresh (SIGHUP reload).
# Leave empty on both sides to allow open catalog access (backwards compat).
MARKETPLACE_CATALOG_TOKEN=

# ── GitHub token — ▸VAULT ────────────────────────────────────────────────────
# Vault secret name: GH-TOKEN
# Used by the portal to download upgrades without user intervention.
GH_TOKEN=

# ── MaxMind GeoIP — ▸VAULT ───────────────────────────────────────────────────
# Vault secret name: MAXMIND-KEY
MAXMIND_KEY=

# ── Cloud CyMISP — ▸VAULT ────────────────────────────────────────────────────
# Vault secret names: CLOUD-MISP-URL, CLOUD-MISP-API-KEY
# The portal uses these when "Cloud CyMISP" is selected in System Settings.
CLOUD_MISP_URL=
CLOUD_MISP_API_KEY=

# ── CyMind — ▸VAULT ──────────────────────────────────────────────────────────
# Vault secret names: CYMIND-API-URL, CYMIND-API-KEY
# Also read by the correlation engine (ENGINE_KV_MAP) and cy_comp policy RAG.
CYMIND_API_URL=
CYMIND_API_KEY=

# ── ASM scan API keys — ▸VAULT (operator-populated) ─────────────────────────
# These are in ASM_KV_MAP in core/kv_secrets.py — loaded at Flask startup.
# NOT auto-pushed by setup.sh; operator must add values to the vault manually.
# An absent/empty key simply disables that ASM module — no errors thrown.
IPINFO_API_KEY=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=
SHODAN_API_KEY=
GOOGLE_GEMINI_KEY=
HUNTER_API_KEY=
HIBP_API_KEY=
GVM_USER=
GVM_PASSWORD=

# ── ASM Scanner tuning — NOT secrets, edit freely ────────────────────────────
ENABLE_EXTENDED_PORT_SCAN=false
ENABLE_UDP_SCAN=false
PROTO_PROBE_TIMEOUT=5
INFRA_EXPOSURE_PORTS=2375,2376,6443,9200,9300,11211,5900,9090,9091,8161

# =============================================================================
# Secrets backend — choose ONE, configure below, leave the others blank.
# =============================================================================
# azure      → Azure Key Vault via DefaultAzureCredential
#              (supports Azure Arc Managed Identity automatically — recommended)
# hashicorp  → HashiCorp Vault via Token or AppRole auth
# infisical  → Infisical via Machine Identity
# (blank)    → no vault; all values must be set in this file
SECRETS_BACKEND=azure

# ── Azure Key Vault ───────────────────────────────────────────────────────────
# Auth tried in order: Arc Managed Identity → Service Principal → az login CLI
AZURE_KEYVAULT_URL=

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=cycentra
# Token auth (dev/CI):
VAULT_TOKEN=
# AppRole auth (recommended for production):
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── Infisical ─────────────────────────────────────────────────────────────────
# INFISICAL_AUTH_METHOD — choose based on your server type:
#   universal  → Client ID + Secret.  Works on ANY server (on-prem, non-Azure,
#                VMs without Arc).  Machine Identity type: "Universal Auth".
#                Set INFISICAL_CLIENT_ID + INFISICAL_CLIENT_SECRET.
#   azure      → Azure Native Auth via Arc MSI.  REQUIRES Azure Arc enrolled.
#                Machine Identity type: "Azure Native Auth".  No secret needed.
#   oidc       → Manual Arc JWT exchange.  REQUIRES Azure Arc enrolled.
#                Machine Identity type: "OIDC".  No secret needed.
INFISICAL_URL=                       # omit for Infisical Cloud
INFISICAL_CLIENT_ID=                 # Machine Identity Client ID from Infisical UI
INFISICAL_AUTH_METHOD=universal      # universal (no Arc) | azure (Arc enrolled) | oidc (Arc enrolled)
INFISICAL_CLIENT_SECRET=             # required for universal auth; leave blank for azure/oidc
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
