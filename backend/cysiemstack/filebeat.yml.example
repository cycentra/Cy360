# filebeat.yml.example
# =====================
# DEPRECATED — kept for reference only.
#
# Filebeat 7.x (Wazuh-distributed) crashes with a seccomp pthread_create
# SIGABRT on Linux kernel 6.x.  CyCentra 360 setup.sh now deploys
# wazuh_to_redis.py (a pure-Python tail watcher) as a systemd service
# called wazuh-to-redis.service instead.
#
# Source: backend/cysiemstack/wazuh_to_redis.py
# Deployed to: /opt/cycentra/wazuh_to_redis.py
# Systemd unit: /etc/systemd/system/wazuh-to-redis.service
#
# The config below is retained only for environments where Filebeat IS working
# and you prefer to use it over the Python watcher.
# ─────────────────────────────────────────────────────────────────────────────

filebeat.inputs:
  - type: log
    enabled: true
    paths:
      - /var/ossec/logs/alerts/alerts.json
    json.keys_under_root: true
    json.overwrite_keys: true
    json.add_error_key: true
    # alerts.json is NDJSON — one complete JSON object per line, no multiline needed

output.redis:
  hosts: ["127.0.0.1:6379"]    # native Redis port (6379)
  key: "cysiemstack:alerts:raw"
  datatype: list
  timeout: 5

# If you already have a Filebeat output to Elasticsearch/OpenSearch for Wazuh Dashboard,
# use the 'output.kafka' or add a second Filebeat instance.
# Filebeat only supports one output — options:
#   1. Run a second Filebeat instance (recommended, simple)
#   2. Use Logstash as a fan-out between Elasticsearch and Redis
#   3. Use the manual ingest endpoint: POST /api/siem/alerts/ingest (admin only)

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 3
