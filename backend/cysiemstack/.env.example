# =============================================================================
# CyCentra 360 — /opt/cycentra/cysiemstack.env
# Engine-specific settings ONLY.  Auto-generated by cycentra-setup.sh.
# DO NOT EDIT MANUALLY — update /opt/cycentra/.env instead.
#
# The cysiemstack-engine.service loads /opt/cycentra/.env first (shared base),
# then this file as overrides.  Vault credentials, API keys (CLOUD_MISP_*,
# CYMIND_*, etc.), and all secrets therefore only need to live in .env.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# asyncpg:// DSN — engine-specific driver format (Flask uses psycopg2://)
DATABASE_URL=postgresql+asyncpg://corruser:CHANGE_ME@127.0.0.1:5433/correlation
# Mirrors DATABASE_URL password — used by --update mode without parsing the DSN
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ALERT_KEY=cysiemstack:alerts:raw

# ── Wazuh Manager API ─────────────────────────────────────────────────────────
# Auto-detected by setup.sh from the local Wazuh dashboard config.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_after_cysiem_install

# ── LLM enrichment ────────────────────────────────────────────────────────────
# Set LLM_ENABLED=false to disable automated background enrichment entirely.
# Manual on-demand analysis (analyst-triggered from portal) is never blocked.
LLM_ENABLED=true

# ── Engine tuning ─────────────────────────────────────────────────────────────
# CORRELATION_WINDOW_MINUTES — idle gap before a new alert opens a fresh incident
# INCIDENT_MAX_AGE_MINUTES   — hard ceiling; incident stops absorbing after this age
CORRELATION_WINDOW_MINUTES=15
INCIDENT_MAX_AGE_MINUTES=30
UEBA_BASELINE_DAYS=30
RISK_DECAY_HOURS=24
INCIDENT_ID_PREFIX=INC
LOG_LEVEL=INFO

# ── ML UEBA ───────────────────────────────────────────────────────────────────
# Shadow mode: ML runs but doesn't affect risk scores (safe default for first week)
UEBA_ML_SHADOW_MODE=true
UEBA_ML_MIN_TRAIN_DAYS=7
UEBA_ML_MODEL_DIR=/opt/cycentra/ml_models

# =============================================================================
# Everything below is inherited from /opt/cycentra/.env — no need to repeat it:
#   SECRETS_BACKEND, AZURE_KEYVAULT_URL, INFISICAL_*, VAULT_*
#   CLOUD_MISP_URL, CLOUD_MISP_API_KEY
#   CYMIND_API_URL, CYMIND_API_KEY
#   BASE_DOMAIN, WAZUH_API_PASSWORD (also set above for --update convenience)
# =============================================================================
