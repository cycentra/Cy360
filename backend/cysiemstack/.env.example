# =============================================================================
# CyCentra 360 — /opt/cycentra/cysiemstack.env
# Loaded by the correlation engine process (cysiemstack.service) ONLY.
# Flask reads /opt/cycentra/.env — this file is separate.
# Written by cycentra-setup.sh on fresh install.  chmod 600.
#
# VAULT-MANAGED KEYS (marked ▸VAULT):
#   Leave EMPTY here. core/kv_secrets.py loads them from the configured
#   secrets backend (Azure KV / HashiCorp / Infisical) via ENGINE_KV_MAP.
#   An empty or absent value triggers the vault fetch.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Port 5433 avoids conflict with CyIRIS postgres on :5432
DATABASE_URL=postgresql+asyncpg://corruser:CHANGE_ME@127.0.0.1:5433/correlation
# Mirrors DATABASE_URL password — used by --update mode without parsing the DSN
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ALERT_KEY=cysiemstack:alerts:raw

# ── Wazuh Manager API ─────────────────────────────────────────────────────────
# Auto-detected by setup.sh from the local Wazuh dashboard config.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_after_cysiem_install

# ── LLM enrichment ────────────────────────────────────────────────────────────
# Provider and credentials are read from /opt/cycentra/ai_settings.json
# (written by the AI Settings page in the portal — no restart needed).
# Set LLM_ENABLED=false to disable entirely.
LLM_ENABLED=false

# ── Cloud CyMISP — ▸VAULT ────────────────────────────────────────────────────
# Vault secret names: CLOUD-MISP-URL, CLOUD-MISP-API-KEY
# The engine uses these for MISP threat-intel enrichment when enabled.
# MISP_ENABLED is set to true via the portal Settings > Integrations page.
CLOUD_MISP_URL=
CLOUD_MISP_API_KEY=
MISP_ENABLED=false

# ── CyMind — ▸VAULT ──────────────────────────────────────────────────────────
# Vault secret names: CYMIND-API-URL, CYMIND-API-KEY
# Used by the correlation engine AI router (ai_router.py) when provider=cymind.
CYMIND_API_URL=
CYMIND_API_KEY=

# ── Engine tuning ─────────────────────────────────────────────────────────────
# CORRELATION_WINDOW_MINUTES — idle gap before a new alert opens a fresh incident
# INCIDENT_MAX_AGE_MINUTES   — hard ceiling; incident stops absorbing after this age
CORRELATION_WINDOW_MINUTES=15
INCIDENT_MAX_AGE_MINUTES=30
UEBA_BASELINE_DAYS=30
RISK_DECAY_HOURS=24
INCIDENT_ID_PREFIX=INC
LOG_LEVEL=INFO

# ── ML UEBA ───────────────────────────────────────────────────────────────────
# Shadow mode: ML runs but doesn't affect risk scores (safe default for first week)
UEBA_ML_SHADOW_MODE=true
UEBA_ML_MIN_TRAIN_DAYS=7
UEBA_ML_MODEL_DIR=/opt/cycentra/ml_models

# ── Filebeat (configured on the host by setup.sh) ────────────────────────────
# Filebeat tails /var/ossec/logs/alerts/alerts.json → pushes to Redis 6379
# Key: cysiemstack:alerts:raw  (must match REDIS_ALERT_KEY above)

# =============================================================================
# Secrets backend — must match SECRETS_BACKEND in /opt/cycentra/.env
# =============================================================================
# ENGINE_KV_MAP keys: CLOUD_MISP_URL, CLOUD_MISP_API_KEY, CYMIND_API_URL, CYMIND_API_KEY
SECRETS_BACKEND=azure                # azure | hashicorp | infisical | (blank = env only)

# ── Azure Key Vault ───────────────────────────────────────────────────────────
AZURE_KEYVAULT_URL=

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=cycentra
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── Infisical ─────────────────────────────────────────────────────────────────
INFISICAL_URL=
INFISICAL_CLIENT_ID=
INFISICAL_AUTH_METHOD=azure          # azure | oidc | universal
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
