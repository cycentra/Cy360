# =============================================================================
# cysiemstack/.env.example
# Copy to .env and fill in your values before running docker compose up -d
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password

# ── Wazuh Manager API ─────────────────────────────────────────────────────────
# The engine queries Wazuh Manager REST API for agent/rule metadata enrichment.
# host.docker.internal resolves to the host machine from inside Docker (Linux).
WAZUH_API_URL=https://host.docker.internal:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your_wazuh_api_password

# ── MISP (optional) ───────────────────────────────────────────────────────────
# Set MISP_ENABLED=true and start with --profile misp to enable MISP enrichment
MISP_ENABLED=false
MISP_API_KEY=
MISP_ADMIN_EMAIL=admin@cycentra.local
MISP_ADMIN_PASSPHRASE=MISPadmin1234!

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Points to your existing Ollama instance (host or remote server).
# Same Ollama used by CyCentra portal AI Settings — they are independent configs.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_ENABLED=true

# ── Engine tuning ─────────────────────────────────────────────────────────────
CORRELATION_WINDOW_MINUTES=15
UEBA_BASELINE_DAYS=30
RISK_DECAY_HOURS=24
INCIDENT_ID_PREFIX=INC
LOG_LEVEL=INFO

# ── ML UEBA ───────────────────────────────────────────────────────────────────
# Shadow mode: ML runs but doesn't affect risk scores (safe default)
UEBA_ML_SHADOW_MODE=true
UEBA_ML_MIN_TRAIN_DAYS=7

# ── Filebeat (for reference — configure on the host, not in Docker) ───────────
# Filebeat should push to: redis://127.0.0.1:6380
# Key: cysiemstack:alerts:raw
# See filebeat.yml.example in this directory.
