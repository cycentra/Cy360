# =============================================================================
# cysiemstack/.env.example
# Native install reference — copy to /opt/cycentra/cysiemstack.env
# (automatically written by cycentra-setup.sh on fresh install)
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Port 5433 avoids conflict with CyIRIS postgres on :5432
DATABASE_URL=postgresql+asyncpg://corruser:changeme@127.0.0.1:5433/correlation

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ALERT_KEY=cysiemstack:alerts:raw

# ── Wazuh Manager API ─────────────────────────────────────────────────────────
# Native all-in-one Wazuh install — API on localhost:55000
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your_wazuh_api_password

# ── MISP (optional) ───────────────────────────────────────────────────────────
# Set MISP_ENABLED=true once MISP is running and configured
MISP_ENABLED=false
MISP_API_KEY=
MISP_URL=http://127.0.0.1:8200

# ── Ollama LLM ────────────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
LLM_ENABLED=true

# ── Engine tuning ─────────────────────────────────────────────────────────────
CORRELATION_WINDOW_MINUTES=15
UEBA_BASELINE_DAYS=30
RISK_DECAY_HOURS=24
INCIDENT_ID_PREFIX=INC
LOG_LEVEL=INFO

# ── ML UEBA ───────────────────────────────────────────────────────────────────
# Shadow mode: ML runs but doesn't affect risk scores (safe default for first week)
UEBA_ML_SHADOW_MODE=true
UEBA_ML_MIN_TRAIN_DAYS=7
UEBA_ML_MODEL_DIR=/opt/cycentra/ml_models

# ── Filebeat (configure on the host) ─────────────────────────────────────────
# Filebeat tails /var/ossec/logs/alerts/alerts.json → pushes to Redis 6379
# Key: cysiemstack:alerts:raw
# See filebeat.yml.example in this directory.
# cycentra-setup.sh auto-configures Filebeat on fresh install.
